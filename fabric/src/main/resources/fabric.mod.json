{
  "schemaVersion": 1,
  "id": "hellenicclient",
  "version": "${version}",

  "name": "Hellenic Client",
  "icon": "web/images/favicon.png",
  "description": "Minecraft Cheat Client. Made by basilakos1.\nOpen http://localhost:5005/ in your browser to access the control panel.",
  "authors": [
    "basilakos1"
  ],
  "contributors": [
    "Zergatul",
    "SomeRandomDude-a"
  ],

  "license": "MIT",

  "environment": "client",
  "entrypoints": {
    "client": [
      "gr.hellenic.client.ModMain"
    ]
  },
  "accessWidener": "hellenicclient.classtweaker",
  "mixins": [
    "hellenicclient.common.mixins.json",
    "hellenicclient.iris.mixins.json",
    "hellenicclient.fnf.mixins.json",
    "hellenicclient.fabric.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=0.18.2",
    "minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
  },
  "suggests": {
    "another-mod": "*"
  }
}